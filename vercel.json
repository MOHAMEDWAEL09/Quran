{
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/assetlinks.json"
    },
    {
      "source": "/mp3q/:path*",
      "destination": "https://www.mp3quran.net/:path*"
    }
  ],
  "headers": [
    {
      "source": "/mp3q/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
